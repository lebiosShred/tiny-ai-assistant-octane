{
  "name": "tiny-ai-assistant",
  "version": "2.0.0",
  "engines": {
    "node": "20.x"
  },
  "description": "Early Game Sales Pipeline backend for Octane Software Solutions",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test:prompts": "promptfoo eval",
    "test:prompts:view": "promptfoo view",
    "test:aegis": "npx playwright test",
    "test:aegis:prod": "npx playwright test",
    "test:aegis:ui": "npx playwright test --ui",
    "test:aegis:report": "npx playwright show-report",
    "test:aegis:update-snapshots": "npx playwright test --update-snapshots",
    "test:aegis:legacy": "node tests/run_aegis.js",
    "test:redteam": "npx promptfoo@latest redteam run"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "dotenv": "^16.4.5",
    "exa-js": "^2.13.0",
    "googleapis": "^137.0.0",
    "nodemailer": "^8.0.10",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.18.0"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.30.0",
    "@axe-core/playwright": "^4.11.3",
    "@modelcontextprotocol/server-postgres": "latest",
    "@playwright/test": "^1.60.0",
    "playwright": "^1.60.0",
    "promptfoo": "^0.60.0"
  }
}
