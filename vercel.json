{
  "rewrites": [
    { "source": "/openapi.json", "destination": "https://tiny-ai-assistant-351972137415.us-central1.run.app/openapi.json" },
    { "source": "/api/:path*", "destination": "https://tiny-ai-assistant-351972137415.us-central1.run.app/api/:path*" },
    { "source": "/favicon.ico", "destination": "/demo/tiny.png" },
    { "source": "/docs", "destination": "/demo/docs.html" },
    { "source": "/book", "destination": "/demo/book.html" },
    { "source": "/book.css", "destination": "/demo/book.css" },
    { "source": "/", "destination": "/demo/index.html" },
    { "source": "/styles.css", "destination": "/demo/styles.css" },
    { "source": "/app.js", "destination": "/demo/app.js" },
    { "source": "/ai-assistant.js", "destination": "/demo/ai-assistant.js" },
    { "source": "/tiny.png", "destination": "/demo/tiny.png" },
    { "source": "/albert.png", "destination": "/demo/albert.png" },
    { "source": "/isha.png", "destination": "/demo/isha.png" },
    { "source": "/screencast/:path*", "destination": "/demo/screencast/:path*" }
  ]
}
