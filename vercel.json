{
  "version": 2,
  "cleanUrls": true,
  "builds": [
    {
      "src": "Tiny AI Assistant/**",
      "use": "@vercel/static"
    },
    {
      "src": "Tiny AI Assistant/assets/**",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://tiny-ai-assistant-351972137415.us-central1.run.app/api/$1"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/Tiny%20AI%20Assistant/assets/$1"
    },
    {
      "source": "/projects",
      "destination": "/Tiny%20AI%20Assistant/github_projects.html"
    },
    {
      "source": "/(.*)",
      "destination": "/Tiny%20AI%20Assistant/$1"
    }
  ]
}
