{
  "version": 2,
  "cleanUrls": true,
  "builds": [
    {
      "src": "Tiny Booking/**",
      "use": "@vercel/static"
    },
    {
      "src": "Tiny AI Assistant/**",
      "use": "@vercel/static"
    },
    {
      "src": "Tiny AI Documentation/**",
      "use": "@vercel/static"
    },
    {
      "src": "Tiny AI Assistant/assets/**",
      "use": "@vercel/static"
    },
    {
      "src": "Tiny AI Documentation/screencast/**",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://tiny-ai-assistant-351972137415.us-central1.run.app/api/$1"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/Tiny%20AI%20Assistant/assets/$1"
    },
    {
      "source": "/screencast/(.*)",
      "destination": "/Tiny%20AI%20Documentation/screencast/$1"
    },
    {
      "source": "/projects",
      "destination": "/Tiny%20AI%20Assistant/github_projects.html"
    },

    {
      "source": "/book",
      "destination": "/Tiny%20Booking/index.html"
    },
    {
      "source": "/book/(.*)",
      "destination": "/Tiny%20Booking/$1"
    },
    {
      "source": "/docs",
      "destination": "/Tiny%20AI%20Documentation/index.html"
    },
    {
      "source": "/docs/(.*)",
      "destination": "/Tiny%20AI%20Documentation/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/Tiny%20AI%20Assistant/$1"
    }
  ]
}
