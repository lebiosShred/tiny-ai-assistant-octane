{
  "openapi": "3.0.0",
  "info": {
    "title": "Tiny AI Assistant API",
    "version": "1.1.0",
    "description": "API for prospect call prep dossiers, transcript reports, and web search."
  },
  "servers": [
    {
      "url": "https://octane-tiny-assistant.vercel.app"
    }
  ],
  "paths": {
    "/api/search": {
      "get": {
        "summary": "Search the Web",
        "description": "Performs a live web search using Tavily and returns the summarized results.",
        "operationId": "searchWeb",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "description": "The search query term or phrase.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful web search response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "results": {
                      "type": "string",
                      "description": "Summarized search results."
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
